        <artifactId>jsr331-parent</artifactId>
        <version>3.0.0</version>
    </parent>

    <artifactId>jsr331-choco</artifactId>

    <properties>
        <choco.version>6.0.1</choco.version>
    </properties>

    <name>JSR331 Choco</name>
    <description>JSR-331 adapter for the open source Choco Solver 6 constraint programming library</description>
    <url>https://github.com/OpenRulesSupport/jsr331</url>

    <licenses>
        <license>
            <name>BSD licence</name>
