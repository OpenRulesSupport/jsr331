    <artifactId>jsr331-ssc</artifactId>

    <properties>
        <ssc.version>4.7.8</ssc.version>
    </properties>

    <name>JSR331 SSC</name>
    <description>This is a JSR331 interface for SSC (Software for the Calculation of the Simplex), a Java library for solving linear programming problems v. ${ssc.version}. SSC was designed and developed by Stefano Scarioli.</description>
    <url>https://www.ssclab.org/</url>

    <licenses>
        <license>
            <name>GNU General Public License, Version 3</name>
