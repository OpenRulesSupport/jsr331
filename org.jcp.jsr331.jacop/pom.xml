	<artifactId>jsr331-jacop</artifactId>
	<packaging>jar</packaging>

	<name>JSR 331 JaCoP Adapter</name>
	<description>JSR-331 adapter for the JaCoP constraint solver</description>
	<url>https://github.com/OpenRulesSupport/jsr331/tree/master/org.jcp.jsr331.jacop</url>

	<properties>
		<jacop.version>4.10.0</jacop.version>
