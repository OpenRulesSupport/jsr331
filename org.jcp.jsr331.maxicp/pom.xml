<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.javasolver</groupId>
    <artifactId>jsr331-parent</artifactId>
    <version>3.0.0</version>
  </parent>
  <artifactId>jsr331-maxicp</artifactId>
  <packaging>jar</packaging>
  <name>JSR 331 MaxiCP Adapter</name>
  <description>JSR-331 adapter for the open-source MaxiCP constraint solver.</description>
  <url>https://github.com/OpenRulesSupport/jsr331/tree/master/org.jcp.jsr331.maxicp</url>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <!-- Official MaxiCP release used by this adapter. -->
    <maxicp.version>1.0.0</maxicp.version>
  </properties>
  <licenses>
    <license>
      <name>JCP License</name>
      <url>https://download.oracle.com/otndocs/jcp/constraint-1_1_0-mrel-spec/license.html</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <name>Jacob Feldman</name>
      <email>jacobfeldman@openrules.com</email>
      <organization>OpenRules, Inc.</organization>
      <organizationUrl>https://openrules.com</organizationUrl>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/OpenRulesSupport/jsr331.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/OpenRulesSupport/jsr331.git</developerConnection>
    <url>https://github.com/OpenRulesSupport/jsr331/tree/master/org.jcp.jsr331.maxicp</url>
    <tag>HEAD</tag>
  </scm>
  <dependencies>
    <dependency>
      <groupId>com.javasolver</groupId>
      <artifactId>jsr331</artifactId>
      <version>${jsr331.version}</version>
    </dependency>
    <dependency>
      <groupId>org.maxicp</groupId>
      <artifactId>maxicp</artifactId>
      <version>${maxicp.version}</version>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
